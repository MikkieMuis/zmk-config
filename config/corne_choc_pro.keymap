//#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
//#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#define ZMK_POINTING_DEFAULT_MOVE_VAL 3000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    macros {
        dash_left: dash_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp MINUS &kp GT>;
            label = "DASH_LEFT";
        };

        equals_left: equals_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EQUAL &kp GT>;
            label = "EQUALS_LEFT";
        };

        or: or {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp PIPE &kp PIPE>;
            label = "OR";
        };

        and: and {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp AMPS &kp AMPS>;
            label = "AND";
        };

        equalequal: equalequal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EQUAL &kp EQUAL>;
            label = "EQUALEQUAL";
        };

        notequal: notequal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EXCL &kp EQUAL>;
            label = "NOTEQUAL";
        };

        euro: euro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "EURO";
        };

        Pound: Pound {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "POUND";
        };

        Plusminus: Plusminus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "PLUSMINUS";
        };

        clear_terminal: clear_terminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(U) &kp C &kp L &kp E &kp A &kp R &kp RET>;
            label = "CLEAR_TERMINAL";
        };

        accept_copilot: accept_copilot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(J) &kp LC(E)>;
            label = "ACCEPT_COPILOT";
            wait-ms = <100>;
            tap-ms = <50>;
        };

        tmux_down: tmux_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp DOWN_ARROW>;
            label = "TMUX_DOWN";
        };

        tmux_up: tmux_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp UP_ARROW>;
            label = "TMUX_UP";
        };

        tmux_left: tmux_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp LEFT_ARROW>;
            label = "TMUX_LEFT";
        };

        tmux_right: tmux_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp RIGHT_ARROW>;
            label = "TMUX_RIGHT";
        };

        tmux_vsplit: tmux_vsplit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp DQT>;
            label = "TMUX_VSPLIT";
        };

        tmux_split: tmux_split {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp PRCNT>;
            label = "TMUX_SPLIT";
        };

        tmux_zoom: tmux_zoom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp Z>;
            label = "TMUX_ZOOM";
        };

        tmux_close: tmux_close {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp AMPS>;
            label = "TMUX_CLOSE";
        };

        tmux_copy_mode: tmux_copy_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp LBKT>;
            label = "TMUX_COPY_MODE";
        };

        tmux_pageup: tmux_pageup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp PAGE_UP>;
            label = "TMUX_PAGEUP";
        };

        tmux_create: tmux_create {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp C>;
            label = "TMUX_CREATE";
        };

        tmux_next: tmux_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp N>;
            label = "TMUX_NEXT";
        };

        tmux_prev: tmux_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp P>;
            label = "TMUX_PREV";
        };

        reset_terminal: reset_terminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp RET &kp TILDE &kp DOT>;
            label = "RESET_TERMINAL";
            wait-ms = <100>;
            tap-ms = <50>;
        };
    };

    combos {
        compatible = "zmk,combos";

        BT_RGB_Layer_Toggle {
            bindings = <&tog 5>;
            key-positions = <6 7>;
        };

        arrow_left {
            bindings = <&kp LEFT_ARROW>;
            key-positions = <29 28>;
        };

        arrow_right {
            bindings = <&kp RIGHT_ARROW>;
            key-positions = <39 38>;
        };

        arrow_up {
            bindings = <&kp UP_ARROW>;
            key-positions = <27 13>;
        };

        arrow_down {
            bindings = <&kp DOWN_ARROW>;
            key-positions = <27 39>;
        };
    };

    behaviors {
        fj_holdtap: fj_holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "FJ_HOLDTAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
        };

        a_holdtap: a_holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "A_HOLDTAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            quick-tap-ms = <175>;
        };

        dk_holdtap: dk_holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "DK_HOLDTAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            quick-tap-ms = <175>;
        };

        sl_holdtab: sl_holdtab {
            compatible = "zmk,behavior-hold-tap";
            label = "SL_HOLDTAB";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            quick-tap-ms = <175>;
        };

        copilot_hold_tap: copilot_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "COPILOT_HOLD_TAP";
            bindings = <&accept_copilot>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        del_hoid_tap: del_hoid_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "DEL_HOID_TAP";
            bindings = <&kp>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&kp TAB     &kp Q                  &kp W                   &kp E                      &kp R                     &kp T       &kp C_MUTE             &caps_word  &kp Y    &kp U                      &kp I                &kp O                &kp P                      &kp BSPC
&kp DOLLAR  &a_holdtap LEFT_ALT A  &sl_holdtab LEFT_GUI S  &dk_holdtap LCTRL D        &fj_holdtap LEFT_SHIFT F  &kp G       &kp LC(RIGHT_BRACKET)  &kp RC(E)   &kp H    &fj_holdtap RIGHT_SHIFT J  &dk_holdtap RCTRL K  &sl_holdtab RMETA L  &a_holdtap RIGHT_ALT SEMI  &kp DELETE
&kp STAR    &lt 4 Z                &lt 3 X                 &lt 2 C                    &lt 1 V                   &kp B                                          &kp N    &lt 1 M                    &lt 2 COMMA          &lt 3 DOT            &lt 4 SLASH                &kp UNDER
                                                           &copilot_hold_tap 0 LC(L)  &kp SPACE                 &kp ESCAPE                                     &kp RET  &kp SPACE                  &kp LC(Y)
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        WARPD-NUM {
            display-name = "WARPD";

            // -----------------------------------------------------------------------------------------
            // Warpd & Copy Functions Layer
            // LEFT: Warpd navigation and copy/paste functions (shifted right, leftmost column empty)
            // RIGHT: Numbers (unchanged)

            bindings = <
&kp LC(LG(I))  &none  &none          &kp LG(N)      &kp LG(H)      &kp LG(G)      &none  &kp RS(RG(MINUS))  &none   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none  &kp BSPC
&none          &none  &kp LG(LC(S))  &kp LG(LC(D))  &kp LG(LC(L))  &kp LG(LC(C))  &none  &kp LG(MINUS)      &none   &kp NUMBER_4  &kp N5        &kp NUMBER_6  &none  &none
&none          &none  &none          &kp LG(LC(V))  &kp LG(LS(Y))  &kp LG(LS(W))                            &none   &kp N7        &kp N8        &kp N9        &none  &none
                                     &none          &none          &none                                    &kp N0  &none         &none
            >;
        };

        SYMBOL {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |               | ENT |     | ALT |

            bindings = <
&kp F12     &kp EXCL     &kp AT        &kp HASH  &euro              &kp PRCNT  &clear_terminal  &kp HOME  &kp CARET   &kp AMPS   &Pound         &kp LPAR          &kp RPAR           &none
&kp F11     &equalequal  &dash_left    &and      &kp SINGLE_QUOTE   &kp TILDE  &reset_terminal  &kp END   &kp PLUS    &kp MINUS  &kp BACKSLASH  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none
&kp INSERT  &notequal    &equals_left  &or       &kp DOUBLE_QUOTES  &kp GRAVE                             &Plusminus  &kp EQUAL  &kp PIPE       &kp LEFT_BRACE    &kp RIGHT_BRACE    &none
                                       &none     &none              &none                                 &none       &none      &none
            >;
        };

        FUNCTION {
            display-name = "Div + Num";
            bindings = <
&kp LS(LG(P))  &kp LG(F1)  &kp LG(F2)          &kp LG(F3)   &none                &none                &kp K_VOLUME_UP    &kp C_BRI_UP   &none           &none           &none         &none            &none    &kp LS(LG(Q))
&kp RG(RS(C))  &none       &kp LG(LEFT_ARROW)  &kp LG(TAB)  &kp LG(PRINTSCREEN)  &kp RG(RIGHT_ARROW)  &kp K_VOLUME_DOWN  &kp C_BRI_DEC  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none    &kp LS(LG(F))
&kp RS(RG(E))  &kp F1      &kp F2              &kp F3       &kp F4               &kp F5                                                 &kp F6          &kp F7          &kp F8        &kp F9           &kp F10  &kp LS(LG(U))
                                               &trans       &trans               &trans                                                 &trans          &trans          &trans
            >;
        };

        TMUX_MOUSE {
            display-name = "TMUX_MOUSE";
            bindings = <
&tmux_create  &none       &none       &none        &none         &tmux_split      &tmux_next  &kp LG(LS(T))  &kp LS(LG(L))   &kp PAGE_DOWN   &kp PG_UP     &none            &none  &none
&none         &none       &tmux_left  &tmux_up     &tmux_down    &tmux_right      &tmux_prev  &kp C_PAUSE    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none  &none
&none         &tmux_zoom  &none       &tmux_close  &tmux_vsplit  &none                                       &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none  &none
                                      &none        &tmux_pageup  &tmux_copy_mode                             &mkp LCLK       &mkp MCLK       &mkp RCLK
            >;
        };

        BT_Layer {
            display-name = "BT + RGB";
            bindings = <
&sys_reset  &bt BT_CLR     &bt BT_CLR_ALL  &bootloader    &studio_unlock  &none          &none  &rgb_ug RGB_ON   &none            &none            &none            &none            &none            &none
&none       &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2   &bt BT_SEL 3    &bt BT_SEL 4   &none  &rgb_ug RGB_OFF  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_EFF  &none
&none       &bt BT_DISC 0  &bt BT_DISC 1   &bt BT_DISC 2  &bt BT_DISC 3   &bt BT_DISC 4                          &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_EFR  &studio_unlock
                                           &none          &none           &none                                  &rgb_ug RGB_TOG  &none            &none
            >;
        };
    };
};
