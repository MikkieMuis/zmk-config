#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    macros {
        dash_left: dash_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp MINUS &kp GT>;
            label = "DASH_LEFT";
        };

        equals_left: equals_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EQUAL &kp GT>;
            label = "EQUALS_LEFT";
        };

        or: or {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp PIPE &kp PIPE>;
            label = "OR";
        };

        and: and {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp AMPS &kp AMPS>;
            label = "AND";
        };

        equalequal: equalequal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EQUAL &kp EQUAL>;
            label = "EQUALEQUAL";
        };

        notequal: notequal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EXCL &kp EQUAL>;
            label = "NOTEQUAL";
        };

        euro: euro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "EURO";
        };

        Pound: Pound {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "POUND";
        };

        Plusminus: Plusminus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "PLUSMINUS";
        };

        clear_terminal: clear_terminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(U) &kp C &kp L &kp E &kp A &kp R &kp RET>;
            label = "CLEAR_TERMINAL";
        };

        reset_terminal: reset_terminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp RET &kp TILDE &kp TILDE &kp DOT>;
            label = "RESET_TERMINAL";
        };

        accept_copilot: accept_copilot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(J) &kp LC(E)>;
            label = "ACCEPT_COPILOT";
        };

        tmux_down: tmux_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp DOWN_ARROW>;
            label = "TMUX_DOWN";
        };

        tmux_up: tmux_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp UP_ARROW>;
            label = "TMUX_UP";
        };

        tmux_left: tmux_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp LEFT_ARROW>;
            label = "TMUX_LEFT";
        };

        tmux_right: tmux_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp RIGHT_ARROW>;
            label = "TMUX_RIGHT";
        };

        tmux_vsplit: tmux_vsplit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp DQT>;
            label = "TMUX_VSPLIT";
        };

        tmux_split: tmux_split {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp PRCNT>;
            label = "TMUX_SPLIT";
        };

        tmux_zoom: tmux_zoom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp Z>;
            label = "TMUX_ZOOM";
        };

        tmux_close: tmux_close {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp AMPS>;
            label = "TMUX_CLOSE";
        };

        tmux_copy_mode: tmux_copy_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp LBKT>;
            label = "TMUX_COPY_MODE";
        };

        tmux_pageup: tmux_pageup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp PAGE_UP>;
            label = "TMUX_PAGEUP";
        };
    };

    combos {
        compatible = "zmk,combos";

        BT_Layer {
            bindings = <&none>;
            key-positions = <6 7>;
            layers = <5>;
        };
    };

    behaviors {
        j_holdtap: j_holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "J_HOLDTAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
        };

        a_holdtap: a_holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "A_HOLDTAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            quick-tap-ms = <175>;
        };

        k_holdtap: k_holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "K_HOLDTAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            quick-tap-ms = <175>;
        };

        l_holdtab: l_holdtab {
            compatible = "zmk,behavior-hold-tap";
            label = "L_HOLDTAB";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            quick-tap-ms = <175>;
        };

        s_hold-tap:

        s_hold-tap {
            compatible = "zmk,behavior-hold-tap";
            label = "S_HOLD-TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
        };

        s_hold-tap:

        s_hold-tap { compatible = "zmk,behavior-hold-tap"; };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&kp TAB     &kp Q                  &kp W           &kp E                    &kp R             &kp T       &kp C_MUTE             &caps_word  &kp Y    &kp U                     &kp I                 &kp O               &kp P               &kp BSPC
&kp DOLLAR  &a_holdtap LEFT_ALT A  &mt LEFT_GUI S  &mt LCTRL D              &mt LEFT_SHIFT F  &kp G       &kp LC(RIGHT_BRACKET)  &kp RC(E)   &kp H    &j_holdtap RIGHT_SHIFT J  &k_holdtap RCTRL K    &l_holdtab RMETA L  &mt RIGHT_ALT SEMI  &kp DELETE
&kp STAR    &lt 4 Z                &lt 3 X         &lt 2 C                  &lt 1 V           &kp B                                          &kp N    &lt 1 M                   &lt 2 COMMA           &lt 3 DOT           &lt 4 SLASH         &kp UNDER
                                                   &hold_tap_macro 0 LC(L)  &kp SPACE         &kp ESCAPE                                     &kp RET  &kp SPACE                 &mt LC(Y) DOWN_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        DIV-NUM {
            display-name = "DIV NUM";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | CTRL | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |      |
            // | SHFT | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |      |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |

            bindings = <
&none           &none            &none            &none            &none            &none            &rgb_ug RGB_ON   &kp RS(RG(MINUS))  &none   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none  &kp BSPC
&none           &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_EFF  &rgb_ug RGB_OFF  &kp LG(MINUS)      &none   &kp NUMBER_4  &kp N5        &kp NUMBER_6  &none  &none
&studio_unlock  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_EFR                                      &none   &kp N7        &kp N8        &kp N9        &none  &none
                                                  &none            &none            &rgb_ug RGB_TOG                                      &kp N0  &none         &none
            >;
        };

        SYMBOL {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |               | ENT |     | ALT |

            bindings = <
&none  &kp EXCL     &kp AT        &kp HASH  &euro              &kp PRCNT  &clear_terminal  &none  &kp CARET   &kp AMPS   &Pound         &kp LPAR          &kp RPAR           &none
&none  &equalequal  &dash_left    &and      &kp SINGLE_QUOTE   &kp TILDE  &reset_terminal  &none  &kp PLUS    &kp MINUS  &kp BACKSLASH  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none
&none  &notequal    &equals_left  &or       &kp DOUBLE_QUOTES  &kp GRAVE                          &Plusminus  &kp EQUAL  &kp PIPE       &kp LEFT_BRACE    &kp RIGHT_BRACE    &none
                                  &none     &none              &none                              &none       &none      &none
            >;
        };

        FUNCTION {
            display-name = "Div + Num";
            bindings = <
&kp LS(LG(P))  &kp LG(F1)  &kp LG(F2)          &kp LG(F3)   &none                &none                &kp K_VOLUME_UP    &kp C_BRI_UP   &none           &none           &none         &none            &none  &kp LS(LG(Q))
&kp RG(RS(C))  &none       &kp LG(LEFT_ARROW)  &kp LG(TAB)  &kp LG(PRINTSCREEN)  &kp RG(RIGHT_ARROW)  &kp K_VOLUME_DOWN  &kp C_BRI_DEC  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none  &kp LS(LG(F))
&kp RS(RG(E))  &none       &none               &none        &none                &none                                                  &none           &none           &none         &none            &none  &kp LS(LG(U))
                                               &trans       &trans               &trans                                                 &trans          &trans          &trans
            >;
        };

        TMUX_MOUSE {
            display-name = "TMUX_MOUSE";
            bindings = <
&none  &none       &none       &none        &none         &tmux_split      &none  &kp LG(LS(T))  &none           &kp PAGE_DOWN   &kp PG_UP     &none            &none  &none
&none  &none       &tmux_left  &tmux_up     &tmux_down    &tmux_right      &none  &kp C_PAUSE    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none  &none
&none  &tmux_zoom  &none       &tmux_close  &tmux_vsplit  &none                                  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none  &none
                               &none        &tmux_pageup  &tmux_copy_mode                        &mkp LCLK       &mkp MCLK       &mkp RCLK
            >;
        };

        BT_Layer {
            display-name = "BT_Layer";
            bindings = <
&sys_reset  &bt BT_CLR     &bt BT_CLR_ALL  &bootloader    &studio_unlock  &none          &none  &none  &none  &none  &none  &none  &none  &none
&none       &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2   &bt BT_SEL 3    &bt BT_SEL 4   &none  &none  &none  &none  &none  &none  &none  &none
&none       &bt BT_DISC 0  &bt BT_DISC 1   &bt BT_DISC 2  &bt BT_DISC 3   &bt BT_DISC 4                &none  &none  &none  &none  &none  &none
                                           &none          &none           &none                        &none  &none  &none
            >;
        };
    };
};
